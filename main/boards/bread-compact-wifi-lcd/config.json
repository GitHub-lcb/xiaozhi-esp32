{
    "type": "bread-compact-wifi-lcd",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-lcd",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-gc9a01",
            "sdkconfig_append": [
                "CONFIG_LCD_GC9A01_240X240=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-st7789-240x280",
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X280=y"
            ]
        },
        {
            "name": "bread-compact-wifi-lcd-emote",
            "sdkconfig_append": [
                "CONFIG_LCD_CUSTOM=y",
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                "CONFIG_MMAP_FILE_NAME_LENGTH=32"
            ]
        }
    ]
}
